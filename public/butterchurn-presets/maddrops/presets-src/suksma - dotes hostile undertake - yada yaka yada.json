l_eqs_str":"","warp":"shader_body\n{\nvec2 _uv = uv;\n\n    // PAINTERLY EFFECT:\n    vec2 uv2 = vec2(_uv);\n    const float mipbias = 0.0;\n    vec2 delta2 = texsize.zw*vec2(1.0,1.0);\n    vec3 blurry_color = texture( sampler_main, uv2 + delta2 ).xyz;\n    uv2.xy += (blurry_color.xy-0.37) * 0.03;\n\n    // sample previous frame\n    ret = texture( sampler_main, uv2 ).xyz;\n\n    // darken over time\n    ret -= 0.004;\n\n}","comp":"shader_body\n{\n    float rad_lq = rad * length(texsize.xy)*0.5;\n    float ang_lq = ang;\n    vec2 uv_temp1 = (uv - 0.5) * texsize.xy;\n    float rad_hq = length(uv_temp1);\n    float ang_hq = atan(-uv_temp1.y, uv_temp1.x);\n\n    vec2 uv2 = vec2((uv - 0.5));\n    float rad2 = rad_lq*0.8;\n    float ang2 = ang_lq * M_INV_PI_2;\n\n        // ROTATION OVER TIME\n        #if 1\n          ang2 += time*0.025;   //rotate over time\n        #endif\n\n        // FIN TYPE\n        float fins = 3.0 + floor(rand_preset.z*5.95);\n        #if 1     // SHARP FINS\n          ang2 = fract(ang2*fins)/fins;\n              // ENABLE THIS TO MAKE THE FINS ALTERNATE: (seamless!)\n              ang2 = abs(ang2 - 0.5/fins);\n        #else     // COSINE FINS - a bit slow\n          ang2 = cos(ang2*M_PI_2*fins) * 0.023;\n        #endif\n\n        // RADIAL KALEIDOSCOPING?\n        #if 0\n          rad2 *= g_fTexSize.z;\n            // choose one:\n            //rad2 = mix(rad2, fract(rad2*3.0)/3.0, 0.5);\n            rad2 = cos(rad2*5.0);\n            //rad2 = sqrt(rad2)*0.5;\n            //rad2 += abs(fract(rad2*7.0)-0.5)/7.0 * 1.15;  // stepifier\n            //rad2 += cos(rad2*61.0)*0.02;\n          rad2 *= g_fTexSize.x;\n        #endif\n\n    ang2 *= M_PI_2;\n    uv2 = 0.5 + rad2*vec2(cos(ang2),sin(ang2))*texsize.zw;\n\n    ret = texture(sampler_main, uv2).xyz;\n    ret *= 1.333; // a little bit of overbright\n}"}