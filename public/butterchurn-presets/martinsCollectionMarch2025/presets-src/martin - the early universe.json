    "perFrame": "dt=1/fps ;\nt0=time*0.0018+tini;\n\nd2=exp(-dt*2);\nd3=exp(-dt*0);\nd4=exp(-dt*4);\n\nif (frame%4==0, n=0; loop(res*res*res, mpos[n]*=d2; n+=1); ,0);\nff = sqrt(3000/nums)*(cos(t0*14))*(1-d2); \n\ns1=sin(t0*13)*2;  s2=sin(t0*11)*2;  s3=sin(t0*9)*2;\ns4=sin(t0*23)*7;  s5=sin(t0*29)*5;  s6=sin(t0*31)*7;\ns7=sin(t0*18)*4;  s8=sin(t0*15)*4;  \nreg05=sin(t0*5);\n\ni=0;\nloop (nums+50, //50 shapes\n  if ((i[7]>maxage) || (gmem[i+7]<0),\n    i[2]= (rand(1)-0.5)*reg30;\n    tmp = (i[2]+reg30)/reg30;\n    i[0]=(rand(1)-0.5)/aspectx*tmp;\n    i[1]=(rand(2)-1)*(rand(2)-1)/aspecty*tmp*0.6;\n    i[6]=1-rand(1)*0.3; //ageing factor\n    i[7]=0; //age\n  ,0 );\n\n  x=i[0]; y=i[1]; z=i[2];\n\n  ix=int(res*(.5+x)+.5);\n  iy=int(res*(.5+y)+.5);\n  iz=int(res*(.5+z)+.5);\n  index = max(0,min(res-1,ix))+res*(max(0,min(res-1,iy))+res*max(0,min(res-1,iz)));\n  if ((ix>=0) && (ix<res) && (iy>=0) && (iy<res) && (iz>=0) && (iz<res), \n    mpos[index] +=1;\n  ,0);\n  \n  dens=i[8]*d4 +  sqrt(mpos[index])*ff*(1-d4);\n   \n  ilen=invsqrt(sqr(x) + sqr(y) + sqr(z)+.004);\n  fx= cos(   x*s4 + y*s5 + z*s6+ ilen*s1)*(1+dens*y*ilen);\n  fy= sin(s7+x*s5 + y*s6 + z*s4+ ilen*s2)*(1+dens*z*ilen);\n  fz= sin(s8+x*s6 + y*s4 + z*s5+ ilen*s3)*(1+dens*x*ilen);\n\n  i[3] = i[3]*d4 +fx*(1-d4)*if(i<10*nums,.06,0.02);\n  i[4] = i[4]*d4 +fy*(1-d4)*if(i<10*nums,.04,0.02);\n  i[5] = i[5]*d4 +fz*(1-d4)*if(i<10*nums,.04,0.02);\n\n  i[0] = x*d3 +i[3]*dt;  \n  i[1] = y*d3 +i[4]*dt;  \n  i[2] = z*d3 +i[5]*dt;\n  i[7] += i[6]*dt;\n  i[8] = dens;\n\n  gmem[i]   =i[0];    \n  gmem[i+1] =i[1];    \n  gmem[i+2] =i[2];\n  gmem[i+7] =i[7];\ni+=10);\n\nq28 = .5-.53/aspectx; //xmin\nq29 = .5+.53/aspectx; //xmax \nq30 = .5-.53/aspecty; //ymin;\nq31 = .5+.53/aspecty; //ymin;\nreg31 = aspectx;\nreg32 = aspecty;\n\nzoom=1; dx=dy=0.00; warp=0.0; sx=sy=1; rot= 0.00; sx=sy=1;\n\n\nmonitor = ff;",
