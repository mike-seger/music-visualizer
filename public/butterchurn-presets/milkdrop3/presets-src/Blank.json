    "warp": "shader_body\n{\n    // sample previous frame\n    ret = tex2D( sampler_main, uv ).xyz;\n    \n    // darken (decay) over time\n    ret *= 0.94; //or try: ret -= 0.004;\n}",
    "comp": "shader_body\n{\n    ret = tex2D(sampler_main, uv).xyz;\n    ret = ret*1.5 - 0.1;\n\n    float4 g;\n    float3 d = float3(texsize.zw * 4, 0);\n    g.x = lum(GetBlur1(uv + d.xz));\n    g.y = lum(GetBlur1(uv - d.xz));\n    g.z = lum(GetBlur1(uv + d.zy));\n    g.w = lum(GetBlur1(uv - d.zy));\n    \n    ret *= 0.7;\n    ret.x += saturate(g.x-g.y)*5;\n    ret.z += saturate(g.y-g.x)*5;\n    //ret.xy += (g.xz-g.yw)*3;\n\nret.x = GetBlur1(uv).x*2;\nret.z = GetBlur2(uv).z*3;\n\n}"
