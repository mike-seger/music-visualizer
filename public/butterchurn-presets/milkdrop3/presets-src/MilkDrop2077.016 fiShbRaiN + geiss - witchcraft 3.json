    "perFrame": "dt = 1/fps;\ndec_s = 1-.015*30/fps; dec_m = 1-0.1*30/fps; dec_f = 0.7;\nvol = vol*0.5 + 0.5*(2*bass_att + mid_att*0.8 + treb_att*0.8)/3; vol_ = vol_*dec_f + (1-dec_f)*vol;\navg = avg*dec_m + (1-dec_m)*vol;\n\nis_beat = above(vol, 1.75*peak) * above (time, t0+.25);\nt0 = if(is_beat,time,t0);\npeak = if (is_beat, vol, peak*dec_m);\nindex = (index + is_beat) %32;\nindex2 = (index2 + is_beat*bnot(index))%16;\n\n//biquad lowpass\nfg = BPM/60; Q=1.8; omega = 2*pi*min(0.5,fg/fps); tcos = cos (omega); alpha = sin(omega)/(2*Q);\nb0=(1-tcos)/2; b1=1-tcos; b2=(1-tcos)/2; a0=1+alpha; a1=-2*tcos; a2=1-alpha;\nb0a0=b0/a0; b1a0=b1/a0; b2a0=b2/a0; a1a0=a1/a0; a2a0=a2/a0;\nX = vol; LastOut= b0a0*X + b1a0*in1 + b2a0*in2 - a1a0*ou1 - a2a0*ou2;\nin2 =in1; in1 =X; ou2 =ou1;  ou1 =LastOut; X =LastOut;\nBiVol=X;\n\nmaxind = 0; qavg = 0.1; i=0; \nExcite = (vol-vol_);\nloop (num_res,\n  n = i*8;\n  Freq  = (i/(num_res-1)+minbpm/(maxbpm-minbpm))*(maxbpm-minbpm)/60;\n  Feder = sqr(Freq*2*pi);\n  megabuf (n+4) = megabuf(n+1); megabuf (n+1) *= 1-0.25*dt; \n  EC_Steps = int (10*Freq*dt)+1;\n  loop (EC_Steps, // Euler-Cauchy steps\n    Kraft = Excite - Feder*megabuf(n + 2) ;\n    megabuf (n+1) += Kraft        * dt/EC_Steps;\n    megabuf (n+2) += megabuf(n+1) * dt/EC_Steps;  );\n  beatcos = megabuf(n+1);  beatsin = megabuf(n+2)*Freq*2*pi;\n  quad = sqrt (pow(beatsin,2) + pow(beatcos,2));\n  megabuf (n+3) = megabuf(n+3) *dec_m +  quad* (1-dec_m);\n  if (megabuf(n+3) > megabuf (maxind*8+3), maxind =i,0);\n  qavg = qavg+pow (megabuf(n+3),2);\n  i += 1;);\n\nqavg = sqrt (qavg/num_res); \nqdev = 0; i =0; loop (num_res, qdev += pow(megabuf(i+3)-qavg,2); i += 8; );\nqdev = sqrt (qdev/num_res);\nBPM =   (maxind/(num_res-1)+minbpm/(maxbpm-minbpm))*(maxbpm-minbpm);\n\nm1 = maxind*8;\ncertain = certain * dec_m + (1-dec_m) * megabuf(m1+3)/qavg;\ndbl_beat = megabuf(m1+1) * megabuf (m1+4) < 0;\nsgl_beat = dbl_beat * (megabuf (m1+4) < 0);\npulse = (megabuf(m1+2) > 0)-0.5;\nbcount += dbl_beat;is_rbeat  = dbl_beat && (bcount%2==0);bcount2 += is_rbeat;\ntrel1 += BPM/60*dt;\n\ntrig2 = is_beat && (index%12==0);\nr1 = if (trig2,(rand(17)-1)*0.1,r1); r1_ += min(0.1,max(-0.1, r1-r1_))*dt*5;\nr2 = if (trig2,rand(1)-0.5,r2);      r2_ += min(0.1,max(-0.1, r2-r2_))*dt*5;\nr3 = if (trig2,sqrt(vol)*0.7*sin(rand(24)),r3); r30 = r30*dec_m + (1-dec_m)*r3; r3_ += r30*dt;\nr4 = if (trig2, (rand(2)-1)*rand(2), r4); r4_ +=r4*dt;\n\n//Comp PLANE\nax=-r1_; ay = r3_; az = r2_+j0*jrel;\nc1 = cos(ax); c2 = cos(ay); c3 = cos(az); s1 = sin(ax); s2 = sin(ay); s3 = sin(az);\nq20 = c2*c3;            q21 = c2*s3;            q22= -s2;\nq23 = s1*s2*c3 - c1*s3; q24 = s1*s2*s3 + c1*c3; q25 = s1*c2;\nq26 = c1*s2*c3 + s1*s3; q27 = c1*s2*s3 - s1*c3; q28 = c1*c2;\nq17 = s2*q24*2; q18 = c2*q24*2; //for Profile\n\n//persp. center\njscale = min (1.2, pow(125/(1+BPM),2));\nif (dbl_beat, (j0=rand(2)-1)*jscale; j1=0; j2=((rand(6)-2))*jscale,0);\njrelv = (certain>6.5-min(avg,2)-jrelv+jtime/8 + 2*(BPM > 160)) ; \njrel  = if(dbl_beat, jrelv,jrel);\njtime = max(0,if (jrel, jtime + dt, jtime-dt)); \nq7 = sin(r3_/7+r1_*4); q8 = 1.25+sin(r3_*.77+r1_)*.5*c1; //pfusch\nq9 = 10-j2*jrel; //z pos\n\nif ((index2%5==4) && !jrel, dist = min(20,dist+dt*80), dist = max(10,dist-dt*80));\ndist_ = dist_*dec_m + (1-dec_m)*dist;\n\nq9 = dist_;\n\ntrig1 = is_beat && (index%16==0); \nsax1 = if (trig1, rand(12), sax1);\nsax2 = if (trig1, rand(12), sax2);\nsax3 = if (trig1, rand(6), sax3);\nsax4 = if (trig1, rand(1)-0.5, sax4);\nnstabsoll = if (trig1 && (index2%2==0), int(rand(10)*rand(10)+4), nstabsoll);\nnstab = if (nstabsoll>nstab, nstab+1, if (nstabsoll<nstab, nstab-1,nstab));\n\n//delay chain\nn = 100; loop (100, gmegabuf(n)=gmegabuf(n-1); n-=1); gmegabuf(0) = vol;\n\n//resampled delay chain starts at 500. \nn = 0; num = 60/BPM/dt; //Num delay bins auf nstab abbilden\nsca =   num/nstab;\nloop (nstab,\n  m1 = floor (sca*n); fra = sca*n-m1;\n  gmegabuf(500+n) = (1-fra)*gmegabuf(m1) + fra*gmegabuf(m1+1);\nn +=1);\n\n//2nd resampled delay chain starts at 5000. \nn = 0; num = 60/BPM/dt; //Num delay bins auf nstab abbilden\nsca =   num/200;\ndec = 0.5;\nloop (200,\n  m1 = floor (sca*n); fra = sca*n-m1;\n  gmegabuf(5000+n) = dec*gmegabuf(5000+n) + (1-dec)*1.5*sqrt((1-fra)*gmegabuf(m1) + fra*gmegabuf(m1+1));\nn +=1);\n\n//Now to stabs\nslen = 2; sdia = 0.13;\nn = 100;\nloop (100,\n  megabuf(5000+n)=megabuf(5000+n-1);\n  megabuf(6000+n)=megabuf(6000+n-1);\n  megabuf(7000+n)=megabuf(7000+n-1);\n  megabuf(8000+n)=megabuf(8000+n-1);\nn-=1);;\nmegabuf (5000) = megabuf(5000)*dec_f + (1-dec_f)*sax1;\nmegabuf (6000) = megabuf(6000)*dec_f + (1-dec_f)*sax2;\nmegabuf (7000) = megabuf(7000)*dec_f + (1-dec_f)*sax3;\nmegabuf (8000) = BiVol;\n\np = 1; \nloop (2, \n  stab = 0;\n  loop (nstab,\n    xang = megabuf(5000+25*stab/nstab); yang = megabuf(6000+30*stab/nstab); zang = 0;\n    dia = megabuf(7000+20*stab/nstab) ;\n    c1 = cos(xang); c2 = cos(yang); c3 = cos(zang); \n    s1 = sin(xang); s2 = sin(yang); s3 = sin(zang);\n    ox = 0; oy = 0;  if (p==1, oz = -slen, oz=slen); ;\n    mx = ox*c3 - oy*s3; my = ox*s3 + oy*c3;    ox = mx; oy = my;\n    mx = ox*c2 + oz*s2; mz = - ox*s2 + oz*c2;  ox = mx; oz = mz;\n    my = oy*c1 - oz*s1; mz = oy*s1 + oz*c1;    oy = my; oz = mz;\n    x0 = ox+dia/2; y0 = oy; z0 = oz+slen+.1;\n\nx0 += pow(cos(stab/nstab*index2 + trel1*pi/2),3)*certain/3;\nz0 += pow(sin(stab/nstab*(8-index2) + trel1*pi/3),3)*certain/3;\nx0 += 4*(sax1*certain*q9/10>sax2*24)*pow(sin(trel1*pi/2+stab/nstab*pi*4),5);\n\n    xang = 0; yang = 0; zang = 2*pi * stab/nstab+r4_; //alle Stebe anordnen\n    ox = x0; oy=y0;  oz=z0;  \n    c1 = cos(xang); c2 = cos(yang); c3 = cos(zang); \n    s1 = sin(xang); s2 = sin(yang); s3 = sin(zang);\n    mx = ox*c3 - oy*s3; my = ox*s3 + oy*c3;    ox = mx; oy = my;\n    mx = ox*c2 + oz*s2; mz = - ox*s2 + oz*c2;  ox = mx; oz = mz;\n    my = oy*c1 - oz*s1; mz = oy*s1 + oz*c1;    oy = my; oz = mz;\n    oz += max(0,certain-2.5)/5*BiVol/(0.2+sqrt(ox*ox+oy*oy));\n\n    base = p*1000+4*stab;\n    gmegabuf (base)=ox;\n    gmegabuf (base+1)=oy;\n    gmegabuf (base+2)=oz;\nstab += 1); \np += 1);\n\nreg33 = index2%2;\nreg32 = is_beat ;\nq3 = min(vol_,3)*1.5;\nq11 = trel1;\n\nreg10 = nstab; \nreg11 = sdia; //Dicke Stab\nq31 = aspectx;\nq32 = aspecty;\nq19 = min(3,1/pow(avg+0.1,0.7))*1.7;\n\n\n//shape 4\nr0 = 0.38-0.4*gmegabuf(5000);\nx0 = 0;\ny0 = 0;\nz0 = 2*-r0+0.5; \nreg77 = z0; //fuer shape 4\nNenner = q9 + q28*x0 + q26*y0 - q27*z0;\nx = (q7 + q22*x0 + q20*y0 -q21*z0)/Nenner + 0.5;\ny = -(q8 + q25*x0 + q23*y0 -q24*z0 )/Nenner*q32 +0.5;\nq15 = x-0.5; q16 = y-0.5;\n\nz0 = -z0;\nNenner = q9 + q28*x0 + q26*y0 - q27*z0;\nx = (q7 + q22*x0 + q20*y0 -q21*z0)/Nenner + 0.5;\ny = -(q8 + q25*x0 + q23*y0 -q24*z0 )/Nenner*q32 +0.5;\nq5 = x-0.5; q6 = y-0.5;\n\n//back light comp\ncirc = ((index2/2)%2==0); \nif (circ,\nx0 = sin (trel1*pi/2)*50;\ny0 = cos (trel1*pi/2)*50;\n,\nx0 = sin (bcount+r1)*50;\ny0 = cos (bcount+r1)*50;\n);\n\nz0 = 3;\nNenner = q9 + q28*x0 + q26*y0 - q27*z0;\nx = (q7 + q22*x0 + q20*y0 -q21*z0)/Nenner + 0.5;\ny = -(q8 + q25*x0 + q23*y0 -q24*z0 )/Nenner*q32 +0.5;\nq1 = x-0.5; q2 = y-0.5;\nq31 = nenner > 0;\n\nz0 = -3;\nNenner = q9 + q28*x0 + q26*y0 - q27*z0;\nx = (q7 + q22*x0 + q20*y0 -q21*z0)/Nenner + 0.5;\ny = -(q8 + q25*x0 + q23*y0 -q24*z0 )/Nenner*q32 +0.5;\nq10 = x-0.5; q12 = y-0.5;\n\ns4 = s4*0.5 + 0.5*(sax4 * (certain*2 > index2));\ntband += .05*abs(s4)*dt;\nq30 = tband; //tile move\nmonitor = bivol;",
