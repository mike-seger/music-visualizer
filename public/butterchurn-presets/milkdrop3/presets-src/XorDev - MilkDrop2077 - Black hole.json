  "comp": "mat2 xll_transpose_mf2x2(mat2 m) {\n  return mat2( m[0][0], m[1][0], m[0][1], m[1][1]);\n}\nmat3 xll_transpose_mf3x3(mat3 m) {\n  return mat3( m[0][0], m[1][0], m[2][0],\n               m[0][1], m[1][1], m[2][1],\n               m[0][2], m[1][2], m[2][2]);\n}\nmat4 xll_transpose_mf4x4(mat4 m) {\n  return mat4( m[0][0], m[1][0], m[2][0], m[3][0],\n               m[0][1], m[1][1], m[2][1], m[3][1],\n               m[0][2], m[1][2], m[2][2], m[3][2],\n               m[0][3], m[1][3], m[2][3], m[3][3]);\n}\n shader_body {  \n    float aspect = (aspect_1.x / aspect_1.y);\n    vec2 aspect_scale = vec2( aspect, 1.0);\n\n    vec2 uv_centered = ((uv - 0.5) * 1.8);\n    vec2 p = (uv_centered * aspect_scale);\n    vec2 d = vec2( -1.0, 1.0);\n\n    vec2 c = (p * xll_transpose_mf2x2(mat2( 1.0, 1.0, (d / (0.5 + (5.0 / dot( ((5.0 * p) - d), ((5.0 * p) - d))))))));\n    vec2 v = c;\n    v = ((v * mat2( cos(((log(length(v)) + (time * 0.5)) + vec4( 0.0, 33.0, 11.0, 0.0))))) * 5.0);\n\n    vec4 o = vec4( 0.0);\n    float i = 0.0;\n    for ( ; (i < 9.0); (i++)) {\n        o += (sin(vec4( v.x, v.y, v.y, v.x)) + 1.0);\n        v += (((0.9 * sin(((vec2( v.y, v.x) * i) + time))) / i) + 0.5);\n    }\n\n    ret = vec3( (1.0 - exp(((((((-exp((c.x * vec4( 0.6, (-0.4 + bass_att), 1.4, 0.0)))) / o) / (0.1 + (0.1 * pow( (length(((sin((v / 0.3)) * 0.2) + (c * vec2( 1.0, 2.0)))) - 1.0), 2.0)))) / (1.0 + ((bass_att * 5.0) * exp(((0.3 * c.y) - dot( c, c)))))) / (0.03 + abs((length(p) - 0.7)))) * 0.2))));\n\n      }",
